# Copia este archivo como .env y rellena tus valores

ANTHROPIC_API_KEY=sk-ant-...

# Modelo de Whisper: tiny, base, small, medium, large-v3
# Más grande = más preciso pero más lento. "base" es un buen equilibrio.
WHISPER_MODEL=base

# Duración de cada chunk de audio en segundos
AUDIO_CHUNK_DURATION=3

# Segundos de silencio antes de enviar texto acumulado a Claude
SILENCE_THRESHOLD=2
